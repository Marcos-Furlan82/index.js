// Schema do banco (PostgreSQL / Neon).
// A URL de conexão fica em prisma.config.ts (Prisma 7) e, em tempo de execução,
// no adapter "pg" (src/lib/db.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Acesso
// ---------------------------------------------------------------------------

model Usuario {
  id        String   @id @default(uuid())
  email     String   @unique
  nome      String
  senhaHash String
  criadoEm  DateTime @default(now())
  sessoes   Sessao[]
}

model Sessao {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// sha256 do token do cookie; o token em si nunca é guardado.
  tokenHash String   @unique
  expiraEm  DateTime
  criadoEm  DateTime @default(now())
  ip        String?
  userAgent String?

  @@index([usuarioId])
}

model TentativaLogin {
  id       String   @id @default(uuid())
  email    String
  ip       String
  sucesso  Boolean
  criadoEm DateTime @default(now())

  @@index([email, criadoEm])
  @@index([ip, criadoEm])
}

// ---------------------------------------------------------------------------
// Contas (mínimo da fase 0; token e scopes entram na fase 6)
// ---------------------------------------------------------------------------

enum StatusConta {
  ATIVA
  PAUSADA
}

model ContaInstagram {
  id                 String                @id @default(uuid())
  nome               String
  usuarioInstagram   String?
  status             StatusConta           @default(ATIVA)
  /// Cota opcional dentro do teto geral. Sem valor: a conta usa só o teto geral.
  tetoMensalBrl      Decimal?              @db.Decimal(12, 2)
  fuso               String                @default("America/Sao_Paulo")
  /// Produto principal (exatamente um por conta; ponteiro único em vez de índice parcial).
  produtoPrincipalId String?               @unique
  produtoPrincipal   Produto?              @relation("ProdutoPrincipal", fields: [produtoPrincipalId], references: [id], onDelete: SetNull)
  /// Arquivada: sai do seletor e fica só para leitura (nunca apagamos).
  arquivadaEm        DateTime?
  criadoEm           DateTime              @default(now())
  atualizadoEm       DateTime              @default(now()) @updatedAt
  jobs               Job[]
  midias             Midia[]
  geracoes           GeracaoIA[]
  marca              Marca?
  produtos           Produto[]             @relation("ProdutosDaConta")
  fichas             FichaProduto[]
  referencias        Referencia[]
  conjuntos          ConjuntoReferencias[]
  reservas           ReservaOrcamento[]
  notificacoes       Notificacao[]
}

// ---------------------------------------------------------------------------
// Briefing: marca (por conta), produtos, isca e ficha do produto
// ---------------------------------------------------------------------------

/// Respostas do briefing que valem para a conta inteira (perguntas 2, 6, 7, 8, 10, 11, 12,
/// cores, fontes e links). JSON validado por zod em src/briefing/esquemas.ts.
model Marca {
  id                      String         @id @default(uuid())
  contaId                 String         @unique
  conta                   ContaInstagram @relation(fields: [contaId], references: [id], onDelete: Cascade)
  briefing                Json           @default("{}")
  /// Última etapa visitada do assistente (1 a 5), para retomar de onde parou.
  etapaAtual              Int            @default(1)
  briefingIniciadoEm      DateTime?
  referenciasConcluidasEm DateTime?
  criadoEm                DateTime       @default(now())
  atualizadoEm            DateTime       @default(now()) @updatedAt
}

model Produto {
  id           String          @id @default(uuid())
  contaId      String
  conta        ContaInstagram  @relation("ProdutosDaConta", fields: [contaId], references: [id], onDelete: Cascade)
  principalDe  ContaInstagram? @relation("ProdutoPrincipal")
  nome         String
  /// Perguntas 1, 3, 4 e 5 (provas com id estável). Ver src/briefing/esquemas.ts.
  briefing     Json            @default("{}")
  ordem        Int             @default(0)
  arquivadoEm  DateTime?
  /// Último job de geração da ficha (estado "gerando", "erro", "tentar de novo").
  geracaoJobId String?
  isca         Isca?
  fichas       FichaProduto[]
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @default(now()) @updatedAt

  @@index([contaId])
}

enum EscolhaIsca {
  TEM
  SUGESTAO
  SEM_ISCA
}

enum FormatoIsca {
  CHECKLIST_PDF
  AULA_VIDEO
  CUPOM
  DIAGNOSTICO
  TESTE_GRATIS
  AMOSTRA
  OUTRO
}

enum EntregaIsca {
  LINK_BIO
  DM
  WHATSAPP
  EMAIL
}

model Isca {
  id             String       @id @default(uuid())
  produtoId      String       @unique
  produto        Produto      @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  escolha        EscolhaIsca
  descricao      String?
  formato        FormatoIsca?
  comoRecebe     EntregaIsca?
  link           String?
  pronta         Boolean      @default(false)
  previsaoPronta DateTime?    @db.Date
  /// Chave da sugestão do nicho escolhida (src/briefing/sugestoes-isca.ts).
  sugestaoChave  String?
  criadoEm       DateTime     @default(now())
  atualizadoEm   DateTime     @default(now()) @updatedAt
}

enum StatusFicha {
  RASCUNHO
  APROVADA
  SUBSTITUIDA
}

enum OrigemFicha {
  IA
  EDICAO
}

/// Ficha do produto, versionada. Toda edição cria uma nova versão.
model FichaProduto {
  id                    String         @id @default(uuid())
  produtoId             String
  produto               Produto        @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  contaId               String
  conta                 ContaInstagram @relation(fields: [contaId], references: [id], onDelete: Cascade)
  versao                Int
  status                StatusFicha    @default(RASCUNHO)
  origem                OrigemFicha
  /// JSON validado por esquemaFicha (src/especialistas/produto/esquema.ts).
  conteudo              Json
  versaoPrompt          String?
  modelo                String?
  /// Job que gerou a versão (IA). Único: repetir o job nunca cria outra versão.
  jobId                 String?        @unique
  instrucao             String?
  baseVersao            Int?
  blocosRevisados       String[]       @default([])
  pendenciasDispensadas String[]       @default([])
  aprovadaEm            DateTime?
  aprovadaPor           String?
  criadoEm              DateTime       @default(now())

  @@unique([produtoId, versao])
  @@index([contaId])
}

// ---------------------------------------------------------------------------
// Fila de jobs
// ---------------------------------------------------------------------------

enum StatusJob {
  PENDENTE
  EXECUTANDO
  CONCLUIDO
  FALHOU
  CANCELADO
}

model Job {
  id                String          @id @default(uuid())
  tipo              String
  contaId           String?
  conta             ContaInstagram? @relation(fields: [contaId], references: [id], onDelete: SetNull)
  payload           Json
  resultado         Json?
  status            StatusJob       @default(PENDENTE)
  executarEm        DateTime        @default(now())
  tentativas        Int             @default(0)
  maxTentativas     Int             @default(5)
  erro              String?
  chaveIdempotencia String?         @unique
  lockedAt          DateTime?
  iniciadoEm        DateTime?
  concluidoEm       DateTime?
  criadoEm          DateTime        @default(now())
  atualizadoEm      DateTime        @updatedAt

  @@index([status, executarEm])
}

// ---------------------------------------------------------------------------
// Mídia (arquivos no Cloudflare R2)
// ---------------------------------------------------------------------------

enum OrigemMidia {
  UPLOAD
  GEMINI
  VEO
  RENDER
}

enum StatusMidia {
  PENDENTE
  DISPONIVEL
  REJEITADA
}

model Midia {
  id             String          @id @default(uuid())
  contaId        String?
  conta          ContaInstagram? @relation(fields: [contaId], references: [id], onDelete: SetNull)
  origem         OrigemMidia
  status         StatusMidia     @default(PENDENTE)
  chave          String          @unique
  tipoMime       String
  tamanhoBytes   BigInt
  nomeOriginal   String
  urlPublica     String?
  largura        Int?
  altura         Int?
  duracaoSeg     Decimal?        @db.Decimal(10, 3)
  licenca        String?
  /// Guardada no bucket privado (sem URL pública; leitura por URL assinada curta).
  privada        Boolean         @default(false)
  sha256         String?
  miniaturaChave String?
  temAlfa        Boolean?
  criadoEm       DateTime        @default(now())
  confirmadoEm   DateTime?
  referencia     Referencia?

  @@index([status, criadoEm])
}

// ---------------------------------------------------------------------------
// Referências visuais (bucket privado)
// ---------------------------------------------------------------------------

enum CategoriaReferencia {
  LOGO
  LOGO_NEGATIVO
  SIMBOLO
  LOGO_ARQUIVO_FONTE
  FONTE
  ARTE
  PROVA
}

enum OrigemReferencia {
  PROPRIA
  TERCEIROS
}

enum FormatoReferencia {
  POST
  CARROSSEL
  STORIES
  CAPA_REELS
}

enum PesoReferencia {
  EXATO
  SO_A_IDEIA
}

model Referencia {
  id                    String              @id @default(uuid())
  contaId               String
  conta                 ContaInstagram      @relation(fields: [contaId], references: [id], onDelete: Cascade)
  midiaId               String              @unique
  midia                 Midia               @relation(fields: [midiaId], references: [id], onDelete: Cascade)
  categoria             CategoriaReferencia
  origem                OrigemReferencia?
  gosta                 String[]            @default([])
  gostaLivre            String?
  naoGosta              String?
  formato               FormatoReferencia?
  peso                  PesoReferencia?
  direitoDeclarado      Boolean             @default(false)
  licencaFonteDeclarada Boolean             @default(false)
  avisos                String[]            @default([])
  removidaEm            DateTime?
  criadoEm              DateTime            @default(now())
  atualizadoEm          DateTime            @default(now()) @updatedAt

  @@index([contaId, categoria])
}

/// Foto das referências no momento em que a etapa 5 foi concluída (base do manual da fase 2).
model ConjuntoReferencias {
  id          String         @id @default(uuid())
  contaId     String
  conta       ContaInstagram @relation(fields: [contaId], references: [id], onDelete: Cascade)
  versao      Int
  itens       Json
  cores       Json
  fontes      Json
  links       Json
  concluidoEm DateTime       @default(now())

  @@unique([contaId, versao])
}

// ---------------------------------------------------------------------------
// Orçamento e custos de IA
// ---------------------------------------------------------------------------

enum AcaoAoAtingirTeto {
  PARAR_GERACAO
  PRIORIZAR_BARATOS
}

/// Singleton: sempre id = "global".
model Configuracao {
  id                   String            @id @default("global")
  tetoMensalBrl        Decimal           @default(1000) @db.Decimal(12, 2)
  /// Nula até o gestor cadastrar. Sem cotação, nenhuma geração é liberada.
  cotacaoUsdBrl        Decimal?          @db.Decimal(10, 4)
  cotacaoAtualizadaEm  DateTime?
  cotacaoFonte         String            @default("manual")
  cotacaoAtualizadaPor String?
  acaoAoAtingirTeto    AcaoAoAtingirTeto @default(PARAR_GERACAO)
  emailNotificacao     String?
  fuso                 String            @default("America/Sao_Paulo")
  atualizadoEm         DateTime          @updatedAt
}

model PrecoModelo {
  id                     String   @id @default(uuid())
  provedor               String
  modelo                 String
  usdPorMTokEntrada      Decimal? @db.Decimal(14, 6)
  usdPorMTokSaida        Decimal? @db.Decimal(14, 6)
  usdPorMTokCacheLeitura Decimal? @db.Decimal(14, 6)
  usdPorMTokCacheEscrita Decimal? @db.Decimal(14, 6)
  usdPorImagem           Decimal? @db.Decimal(14, 6)
  usdPorSegundoVideo     Decimal? @db.Decimal(14, 6)
  atualizadoEm           DateTime @updatedAt

  @@unique([provedor, modelo])
}

enum TipoGeracao {
  TEXTO
  IMAGEM
  VIDEO
}

model GeracaoIA {
  id                 String            @id @default(uuid())
  contaId            String?
  conta              ContaInstagram?   @relation(fields: [contaId], references: [id], onDelete: SetNull)
  especialista       String?
  provedor           String
  modelo             String
  tipo               TipoGeracao
  versaoPrompt       String?
  tokensEntrada      Int               @default(0)
  tokensSaida        Int               @default(0)
  tokensCacheLeitura Int               @default(0)
  tokensCacheEscrita Int               @default(0)
  imagens            Int               @default(0)
  segundosVideo      Decimal           @default(0) @db.Decimal(10, 3)
  custoUsd           Decimal?          @db.Decimal(18, 8)
  custoBrl           Decimal?          @db.Decimal(18, 8)
  cotacaoUsada       Decimal?          @db.Decimal(10, 4)
  precoPendente      Boolean           @default(false)
  precosAplicados    Json?
  /// "AAAA-MM" no fuso de São Paulo.
  mesReferencia      String
  reservaId          String?
  reserva            ReservaOrcamento? @relation(fields: [reservaId], references: [id], onDelete: SetNull)
  criadoEm           DateTime          @default(now())

  @@index([mesReferencia, contaId])
  @@index([reservaId])
}

enum StatusReserva {
  ATIVA
  CONCILIADA
  LIBERADA
  EXPIRADA
  /// Conciliada com uso de um modelo sem preço: o valor reservado continua contando.
  PENDENTE_PRECO
}

/// Valor separado do orçamento antes de uma chamada de IA (evita estourar o teto
/// com gerações simultâneas). Conciliada com o custo real depois da chamada.
model ReservaOrcamento {
  id            String          @id @default(uuid())
  contaId       String?
  conta         ContaInstagram? @relation(fields: [contaId], references: [id], onDelete: SetNull)
  mesReferencia String
  valorBrl      Decimal         @db.Decimal(18, 8)
  status        StatusReserva   @default(ATIVA)
  expiraEm      DateTime
  /// "job:<id>"
  origem        String
  finalizadaEm  DateTime?
  criadoEm      DateTime        @default(now())
  geracoes      GeracaoIA[]

  @@index([mesReferencia, status])
  @@index([contaId, mesReferencia])
}

model AlertaOrcamento {
  id            String   @id @default(uuid())
  mesReferencia String
  /// "geral" ou o id da conta.
  escopo        String
  limiar        Int
  percentual    Decimal  @db.Decimal(8, 2)
  criadoEm      DateTime @default(now())

  @@unique([mesReferencia, escopo, limiar])
}

// ---------------------------------------------------------------------------
// Notificações do painel
// ---------------------------------------------------------------------------

model Notificacao {
  id       String          @id @default(uuid())
  contaId  String?
  conta    ContaInstagram? @relation(fields: [contaId], references: [id], onDelete: SetNull)
  tipo     String
  titulo   String
  mensagem String
  link     String?
  lidaEm   DateTime?
  criadoEm DateTime        @default(now())

  @@index([lidaEm, criadoEm])
}
