# Copie para .env e preencha. Nunca versione o .env.
# No Netlify, cadastre as mesmas variáveis em Site configuration → Environment variables.

# --- Banco (Neon) ---------------------------------------------------------
# Conexão com pooler (host com "-pooler"): usada pelo app e pelas funções.
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# Conexão direta (sem "-pooler"): usada só pelas migrations (prisma migrate).
DIRECT_URL="postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# Banco SÓ para testes de integração (é apagado a cada teste). Local ou um branch do Neon.
DATABASE_URL_TEST="postgresql://planejador:planejador@localhost:5432/planejador_teste"
# Opcional: máximo de conexões por instância (padrão 5 no app, 2 nas funções).
# DB_POOL_MAX=5

# --- App -------------------------------------------------------------------
# URL pública do painel (fallback para o agendador quando o Netlify não informa a URL).
APP_URL="http://localhost:3000"

# --- Jobs ------------------------------------------------------------------
# Segredo entre a Scheduled Function e a Background Function (32+ caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JOBS_SECRET=""
# Quantas execuções da Background Function podem rodar ao mesmo tempo.
JOBS_PARALELISMO=2

# --- Cloudflare R2 ---------------------------------------------------------
R2_ACCOUNT_ID=""
# Token de API do R2 com permissão de leitura e escrita SÓ neste bucket.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Domínio público do bucket (domínio próprio; evite o r2.dev, que tem limite de taxa).
R2_PUBLIC_BASE_URL="https://midia.seudominio.com.br"
# Bucket PRIVADO das referências da marca (logo, artes, fontes): sem domínio público.
# Mesmo token acima (dê acesso aos dois buckets). Leitura só por URL assinada de 5 min.
R2_BUCKET_PRIVADO=""

# --- E-mail ----------------------------------------------------------------
# resend (produção), console (desenvolvimento: só registra no log) ou memoria (testes)
EMAIL_PROVEDOR="console"
RESEND_API_KEY=""
# Remetente de um domínio verificado no Resend.
EMAIL_REMETENTE="Planejador <avisos@seudominio.com.br>"

# --- IA de texto (Claude API) ----------------------------------------------
# Chave da API da Anthropic. Configure também um limite de gasto no console da Anthropic.
ANTHROPIC_API_KEY=""
# Modelo de texto (padrão: claude-opus-5-5). Cadastre o preço dele e dos modelos de
# fallback em Configurações → Orçamento antes de gerar.
# IA_MODELO_TEXTO="claude-opus-5-5"
# Fallback no servidor quando o modelo recusa um pedido: default (recomendado) ou desligado.
IA_FALLBACK="default"

# --- Próximas fases (ainda não usadas) ---------------------------------------
# GEMINI_API_KEY=""      # fase 4
# META_APP_ID=""         # fase 6
# META_APP_SECRET=""     # fase 6
# ENCRYPTION_KEY=""      # fase 6 (criptografia dos tokens da Meta)
