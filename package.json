{
  "name": "planejador-instagram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integracao": "vitest run --project integracao",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "gestor:criar": "tsx scripts/criar-gestor.ts",
    "jobs:rodar": "tsx scripts/rodar-jobs.ts",
    "demo:dados": "tsx scripts/demo-dados.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@date-fns/tz": "^1.5.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "jsdom": "^30.1.3",
    "next": "16.4.1",
    "pg": "^8.23.1",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "resend": "^6.33.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@netlify/functions": "6.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "aws-sdk-client-mock": "^4.1.0",
    "dotenv": "^18.0.8",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
